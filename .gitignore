benchrec_report.md

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Secrets — never commit. The repo is already published; a key committed here
# would persist in git history even after deletion.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
secrets.json

# Investigation output (may quote transaction data)
investigations.jsonl

# Exported front-end data — regenerate with: python export.py
# 13,000+ small JSON files; the source of truth is the audit + solution files.
web/data/

# Regenerated by check.py on demand; not source.
screenshots/
.vercel
.env*

# Vercel CLI, installed locally for deployment only
node_modules/
